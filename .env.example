# ---- Environment ----
# production | preview | development. On Vercel this is derived from VERCEL_ENV automatically.
# Only a production build may be indexed by search engines.
SITE_ENV=development

# ---- Enquiry email delivery (server only — never prefix with NEXT_PUBLIC_) ----
# Transactional email API key (Resend). Requires the sending domain to be verified (SPF/DKIM DNS records).
EMAIL_API_KEY=
# Optional override for testing; defaults to https://api.resend.com/emails
EMAIL_API_URL=
# Where enquiries are delivered
ENQUIRY_TO=info@codemindset.in
# Verified sender address on codemindset.in, e.g. "CodeMindset website <website@codemindset.in>"
ENQUIRY_FROM=

{
  "name": "codemindset-website",
  "version": "0.1.0",
  "private": true,
  "description": "CodeMindset website — Indian IT services company. Think in Algorithms.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:launch": "tsx scripts/check-launch.ts",
    "brand": "node scripts/build-brand.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@vercel/analytics": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "chrome-launcher": "^1.2.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.0.0",
    "lighthouse": "^12.8.0",
    "prettier": "^3.6.0",
    "sharp": "^0.34.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
